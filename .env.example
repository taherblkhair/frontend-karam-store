# ── Local development (recommended) ─────────────────────────────────────────
# Empty = same-origin /api via Vite proxy → no CORS issues
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://api.karamstore.ly

# Local backend instead of remote (when PROXY_TARGET is unset or empty):
# VITE_API_PROXY_TARGET=
# VITE_API_PORT=3001

# ── Production build (direct browser → API) ──────────────────────────────────
# VITE_API_BASE_URL=https://api.karamstore.ly
# Server must allow CORS for your frontend origin.

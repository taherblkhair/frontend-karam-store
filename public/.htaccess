# Karam Store — Apache / cPanel (SPA + social link previews)
#
# Humans: product URLs fall through to index.html (React router).
# Crawlers (WhatsApp, Facebook/Instagram previews, …): proxy HTML with Open Graph
# via share-product.php → API /share/product/:slug

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite real files / directories (assets, favicon, php, …)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Social / preview bots → dynamic OG document for /product/:slug
  # - In-app browsers (Instagram, Facebook, Threads, TikTok) are real shoppers: their UA
  #   contains "Instagram 312.0…" / "FBAN" etc. Sending them to the shim made an endless
  #   redirect loop (the shim redirects back to /product/:slug).
  #   Meta's preview crawler for Instagram/Facebook links is "facebookexternalhit".
  # - via=share marks the shim's own redirect back to the SPA, so it can never loop.
  RewriteCond %{QUERY_STRING} !(^|&)via=share(&|$)
  RewriteCond %{HTTP_USER_AGENT} !(FBAN|FBAV|FB_IAB|FBIOS|FB4A|Instagram\ [0-9]|Barcelona|BytedanceWebview|musical_ly|Snapchat) [NC]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|FacebookBot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|SkypeUriPreview|Applebot|Pinterest|Embedly|redditbot|Quora\ Link\ Preview|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Slurp|ia_archiver|MetaInspector|bot|crawler|spider) [NC]
  RewriteRule ^product/(.+)$ share-product.php?slug=$1 [L,QSA,B]

  # SPA client-side routes
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory listing
Options -Indexes

# MIME types for modern assets (harmless if already set)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# In-app browsers cache aggressively: index.html must always be revalidated so it never
# points at hashed bundles removed by a newer deploy (blank page). Hashed assets are immutable.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
